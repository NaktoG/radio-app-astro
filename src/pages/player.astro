---
import RadioLayout from '../layouts/RadioLayout.astro'
import Dial from '../components/Dial'
const english = Astro.locals.lang === 'en'
---

<RadioLayout title="Radio App · En vivo">
  <Dial
    client:load
    english={english}
    profile={Boolean(Astro.locals.user)}
    nickname={Astro.locals.user?.nickname || ''}
  />
</RadioLayout>
