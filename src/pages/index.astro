---
import '../styles/global.css'
import Dial from '../components/Dial'
const lang = Astro.locals.lang === 'en' ? 'en' : 'es'
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    /><meta name="theme-color" content="#0c111d" />
    <title>Radio App · Dial</title><link rel="manifest" href="/manifest.webmanifest" /><link
      rel="icon"
      href="/favicon.svg"
    />
  </head><body
    ><a class="sr-only focus:not-sr-only" href="#main"
      >{lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a
    ><Dial client:load english={lang === 'en'} profile={Boolean(Astro.locals.user)} />
    <footer class="flex flex-wrap justify-center gap-4 pb-36">
      <a href="/legal/privacy">{lang === 'en' ? 'Privacy' : 'Privacidad'}</a><a href="/legal/terms"
        >{lang === 'en' ? 'Terms' : 'Términos'}</a
      ><a href="/legal/faq">FAQ</a><button id="language"
        >{lang === 'en' ? 'Español' : 'English'}</button>
    </footer>
    <script>
      document.querySelector('#language')?.addEventListener('click', () => {
        document.cookie =
          'radio_lang=' +
          (document.documentElement.lang === 'en' ? 'es' : 'en') +
          ';path=/;max-age=31536000;SameSite=Lax'
        location.reload()
      })
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {})
    </script></body>
</html>
