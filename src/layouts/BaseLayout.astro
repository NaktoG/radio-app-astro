---
import BrandFooter from '../components/shared/BrandFooter.astro'
import ServiceWorker from '../components/shared/ServiceWorker.astro'
import '../styles/global.css'
import '../styles/radio-brand.css'
import '../styles/animations.css'
import Nav from '../components/Nav'
import en from '../i18n/en.json'
import es from '../i18n/es.json'

export interface Props {
  title?: string
}

const lang = Astro.locals.lang as string
const dict = lang === 'en' ? en : es
const { title } = Astro.props
const pageTitle = title ? `${title} | ${dict.NAV.APP_NAME}` : dict.NAV.APP_NAME
const skipLinkText = lang === 'en' ? 'Skip to content' : 'Saltar al contenido'
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={lang === 'en'
        ? 'Listen to radio from around the world - Thousands of live stations'
        : 'Escucha radio de todo el mundo - Miles de estaciones en vivo'}
    />
    <meta name="theme-color" content="#090909" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={dict.NAV.APP_NAME} />
    <meta name="application-name" content={dict.NAV.APP_NAME} />
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/pwa-icon.svg" />
    <link rel="preconnect" href="https://de1.api.radio-browser.info" crossorigin />
    <link rel="dns-prefetch" href="https://de1.api.radio-browser.info" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen text-white flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-[var(--color-accent)] focus:text-white focus:px-4 focus:py-2 focus:rounded-lg"
    >
      {skipLinkText}
    </a>
    <Nav client:load lang={lang} />
    <main id="main" class="flex-1 pt-16 content-layer w-full max-w-full overflow-x-hidden">
      <slot />
    </main>
    <BrandFooter english={lang === 'en'} />

    <ServiceWorker />
  </body>
</html>
