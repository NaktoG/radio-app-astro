---
import '../styles/global.css'
import '../styles/radio-brand.css'
interface Props {
  title?: string
}
const { title = 'Radio App · El mundo en el dial' } = Astro.props
const english = Astro.locals.lang === 'en'
---

<!doctype html>
<html lang={english ? 'en' : 'es'} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#090909" />
    <meta
      name="description"
      content={english
        ? 'Discover live radio from around the world. Your stations, your moment.'
        : 'Descubrí emisoras de todo el mundo. Radio en vivo y tus favoritas en un solo lugar.'}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/radio-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
  </head>
  <body>
    <a class="sr-only focus:not-sr-only" href="#main"
      >{english ? 'Skip to content' : 'Saltar al contenido'}</a
    >
    <slot />
    <footer class="brand-footer">
      <a href="/">Una creación de <strong>LuVal Studio</strong></a><nav aria-label="Legal">
        <a href="/legal/privacy">{english ? 'Privacy' : 'Privacidad'}</a><a href="/legal/terms"
          >{english ? 'Terms' : 'Términos'}</a
        ><button id="radio-language">{english ? 'Español' : 'English'}</button>
      </nav>
    </footer>
    <script>
      document.querySelector('#radio-language')?.addEventListener('click', () => {
        document.cookie = `radio_lang=${document.documentElement.lang === 'en' ? 'es' : 'en'};path=/;max-age=31536000;SameSite=Lax`
        location.reload()
      })
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {})
    </script>
  </body>
</html>
