---
import BrandFooter from '../components/shared/BrandFooter.astro'
import ServiceWorker from '../components/shared/ServiceWorker.astro'
import '../styles/global.css'
import '../styles/radio-brand.css'
interface Props {
  title?: string
}
const { title = 'Radio App · El mundo en el dial' } = Astro.props
const english = Astro.locals.lang === 'en'
---

<!doctype html>
<html lang={english ? 'en' : 'es'} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#090909" />
    <meta
      name="description"
      content={english
        ? 'Discover live radio from around the world. Your stations, your moment.'
        : 'Descubrí emisoras de todo el mundo. Radio en vivo y tus favoritas en un solo lugar.'}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/radio-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
    <title>{title}</title>
  </head>
  <body>
    <a class="sr-only focus:not-sr-only" href="#main"
      >{english ? 'Skip to content' : 'Saltar al contenido'}</a
    >
    <slot />
    <BrandFooter english={english} />

    <ServiceWorker />
  </body>
</html>
