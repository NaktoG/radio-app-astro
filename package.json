{
  "name": "radio-app",
  "version": "4.0.0",
  "description": "Radio App - Streaming de radio mundial con Astro + Preact",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx,.astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:ci": "prettier --check .github/workflows/ci.yml package.json .prettierrc",
    "check": "astro check && tsc --noEmit",
    "validate": "npm run check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/preact": "^4.0.0",
    "@astrojs/vercel": "^11.0.3",
    "@fontsource/space-grotesk": "^5.1.0",
    "@preact/signals": "^2.0.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.0.7",
    "lucide-preact": "^0.460.0",
    "preact": "^10.25.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.49.0",
    "@testing-library/preact": "^3.2.3",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
